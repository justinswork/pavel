{
  "name": "pavel-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Reference age-gated e-commerce demo — the end-to-end testbed for PAVEL. Runs the real middleware + core verifier over real mDL credentials, with a simulated dev wallet standing in for the OS wallet.",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @justinswork/pavel-client build && tsx watch src/server.ts",
    "start": "pnpm --filter @justinswork/pavel-client build && tsx src/server.ts",
    "build:client": "pnpm --filter @justinswork/pavel-client build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@justinswork/pavel": "workspace:*",
    "@justinswork/pavel-client": "workspace:*",
    "@justinswork/pavel-mock-authority": "workspace:*",
    "express": "^4.19.2",
    "express-session": "^1.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0"
  }
}
